<Window x:Class="AthenaOtaUpdater.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Athena OTA Updater" Height="240" Width="560"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Athena OTA Update Agent" FontSize="20" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1" Margin="0,18,0,12">
   <TextBlock x:Name="StatusText" Text="Starting..." TextWrapping="Wrap"/>
   <ProgressBar x:Name="Progress" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Check now" Width="100" Margin="0,0,8,0" Click="CheckNow_Click"/>
   <Button Content="Minimize" Width="100" Click="Minimize_Click"/>
  </StackPanel>
 </Grid>
</Window>
