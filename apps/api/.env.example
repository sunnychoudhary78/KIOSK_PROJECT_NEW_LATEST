SKP_NODE_ENV=local
SKP_PORT=3000
SKP_LOG_LEVEL=info
SKP_DATABASE_URL=postgresql://skp:skp_dev_password@localhost:5434/skp_local?schema=public
SKP_JWT_SECRET=dev-only-change-me-skp-jwt-secret-min-32-chars
SKP_JWT_ACCESS_TTL_SECONDS=3600
SKP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SKP_OTP_TTL_SECONDS=300
SKP_OTP_LENGTH=6
# Global HTTP rate limit. Authenticated Bearer traffic is keyed per token;
# unauthenticated traffic is keyed by client IP. /v1/health is skipped.
SKP_RATE_LIMIT_WINDOW_MS=60000
SKP_RATE_LIMIT_MAX=120
SKP_DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in
SKP_DIGILOCKER_CLIENT_ID=your-client-id
SKP_DIGILOCKER_CLIENT_SECRET=your-client-secret
SKP_DIGILOCKER_REDIRECT_URI=http://192.168.1.30:3000/api/v1/auth/digilocker/callback
SKP_DIGILOCKER_AUTHORIZE_PATH=/public/oauth2/1/authorize
SKP_DIGILOCKER_TOKEN_PATH=/public/oauth2/2/token
SKP_DIGILOCKER_FILES_ISSUED_PATH=/public/oauth2/2/files/issued
SKP_DIGILOCKER_FILES_UPLOADED_PATH=/public/oauth2/1/files
SKP_DIGILOCKER_FILE_PATH_PREFIX=/public/oauth2/1/file
SKP_DIGILOCKER_USER_PATH=/public/oauth2/1/user
SKP_DIGILOCKER_EAADHAAR_PATH=/public/oauth2/3/xml/eaadhaar
SKP_DIGILOCKER_SCOPE=openid
SKP_SMS_PROVIDER=noop
SKP_MSG91_AUTH_KEY=
SKP_MSG91_SENDER_ID=IMRTPS
SKP_MSG91_FLOW_ID=
# Must match ##shortcode## names in the MSG91 Flow template (Test DLT shows these).
SKP_MSG91_OTP_VAR=var1
SKP_MSG91_EXPIRY_VAR=var2
# Razorpay (optional for free OTP print; required to charge extra pages)
SKP_RAZORPAY_KEY_ID=
SKP_RAZORPAY_KEY_SECRET=
SKP_RAZORPAY_WEBHOOK_SECRET=
SKP_PAYMENT_WINDOW_MINUTES=15
# Astrology (VedAstro chart + OpenAI palm/kundali narrative)
SKP_VEDASTRO_BASE_URL=https://api.vedastro.org/api
SKP_AI_PROVIDER=noop
SKP_OPENAI_API_KEY=
SKP_OPENAI_MODEL=gpt-4o
# Private Cloudflare R2 (S3 API). Leave empty in local/test — upload/playback return 503.
# Endpoint example: https://<accountid>.r2.cloudflarestorage.com
# Bucket CORS must allow admin origins (SKP_CORS_ORIGINS) for GET + HEAD with Range,
# and kiosk origins for PUT, or browser playback will fail after a successful list.
SKP_OBJECT_STORAGE_ENDPOINT=
SKP_OBJECT_STORAGE_REGION=auto
SKP_OBJECT_STORAGE_BUCKET=
SKP_OBJECT_STORAGE_ACCESS_KEY=
SKP_OBJECT_STORAGE_SECRET_KEY=
SKP_OBJECT_STORAGE_PUT_TTL_SECONDS=3600
SKP_OBJECT_STORAGE_GET_TTL_SECONDS=900
